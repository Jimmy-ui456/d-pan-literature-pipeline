include LICENSE .gitignore README.md CONTRIBUTING.md LICENSE-CANDIDATE.txt LICENSE-STATUS.md pyproject.toml MANIFEST.in release_allowlist.json
recursive-include litsearch *.py *.json
recursive-include litsearch_zotero *.py
recursive-include tests *.py
recursive-include examples/synthetic *.json
recursive-include docs *.md
recursive-include scripts *.py
recursive-include .github/workflows *.yml
global-exclude *.py[cod] __pycache__/*
